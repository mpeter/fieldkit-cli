{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mpeter/fieldkit-cli/blob/main/docs/release-readiness/release-trust-selection.schema.json",
  "title": "fieldkit release trust selection (structural only)",
  "description": "Structural input contract only. Validation does not authenticate C0, select authority, verify signatures, establish freshness or identity equality, or approve publication. An independently authenticated controller and externally supplied expected identities must precede candidate execution. Member roles are descriptive, not an allowlist.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "selection_id",
    "controller",
    "toolchain",
    "policy",
    "expected_candidate",
    "producer",
    "approval",
    "signer",
    "revocation"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "fieldkit.release-trust-selection"
    },
    "selection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[\\x20-\\x7E]+$(?![\\s\\S])"
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repository_id",
        "owner_id",
        "source_commit",
        "source_tree",
        "manifest_sha256",
        "entrypoint",
        "members"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "repository_id": {
          "$ref": "#/$defs/positive_id"
        },
        "owner_id": {
          "$ref": "#/$defs/positive_id"
        },
        "source_commit": {
          "$ref": "#/$defs/git_oid"
        },
        "source_tree": {
          "$ref": "#/$defs/git_oid"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "entrypoint": {
          "$ref": "#/$defs/relative_path"
        },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "size_bytes",
              "sha256",
              "role"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/relative_path"
              },
              "size_bytes": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "sha256": {
                "$ref": "#/$defs/sha256"
              },
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[\\x20-\\x7E]+$(?![\\s\\S])"
              }
            }
          }
        }
      }
    },
    "toolchain": {
      "$ref": "#/$defs/toolchain"
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "public_tree_policy_sha256",
        "documentation_contract_sha256",
        "receipt_schema_sha256",
        "selection_schema_sha256"
      ],
      "properties": {
        "public_tree_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "documentation_contract_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "receipt_schema_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "selection_schema_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "expected_candidate": {
      "$ref": "#/$defs/candidate"
    },
    "producer": {
      "$ref": "#/$defs/producer"
    },
    "approval": {
      "$ref": "#/$defs/approval"
    },
    "signer": {
      "$ref": "#/$defs/signer"
    },
    "revocation": {
      "$ref": "#/$defs/revocation"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 64,
      "maxLength": 64
    },
    "git_oid": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$(?![\\s\\S])",
      "minLength": 40,
      "maxLength": 40
    },
    "positive_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*$(?![\\s\\S])"
    },
    "repository": {
      "type": "string",
      "minLength": 3,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$(?![\\s\\S])"
    },
    "utc_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,9})?Z$(?![\\s\\S])",
      "maxLength": 30
    },
    "api_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$(?![\\s\\S])",
      "minLength": 71,
      "maxLength": 71
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "sha256"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\x20-\\x7E]+$(?![\\s\\S])"
        },
        "kind": {
          "enum": [
            "wheel",
            "sdist"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "wheel"
              }
            }
          },
          "then": {
            "properties": {
              "name": {
                "const": "fieldkit_cli-1.0.0-py3-none-any.whl"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "sdist"
              }
            }
          },
          "then": {
            "properties": {
              "name": {
                "const": "fieldkit_cli-1.0.0.tar.gz"
              }
            }
          }
        }
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/artifact"
      },
      "allOf": [
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "wheel"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "properties": {
              "kind": {
                "const": "sdist"
              }
            },
            "required": [
              "kind"
            ]
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repository_id",
        "private_source_sha",
        "private_source_tree",
        "exported_tree",
        "public_commit",
        "public_tree",
        "version",
        "planned_tag",
        "package",
        "artifacts",
        "documentation_contract_sha256"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "const": "mpeter/fieldkit-cli"
        },
        "repository_id": {
          "$ref": "#/$defs/positive_id"
        },
        "private_source_sha": {
          "$ref": "#/$defs/git_oid"
        },
        "private_source_tree": {
          "$ref": "#/$defs/git_oid"
        },
        "exported_tree": {
          "$ref": "#/$defs/git_oid"
        },
        "public_commit": {
          "$ref": "#/$defs/git_oid"
        },
        "public_tree": {
          "$ref": "#/$defs/git_oid"
        },
        "version": {
          "type": "string",
          "const": "1.0.0"
        },
        "planned_tag": {
          "type": "string",
          "const": "v1.0.0"
        },
        "package": {
          "type": "string",
          "const": "fieldkit-cli"
        },
        "artifacts": {
          "$ref": "#/$defs/artifacts"
        },
        "documentation_contract_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repository_id",
        "owner_id",
        "workflow_id",
        "run_id",
        "run_attempt",
        "head_repository_id",
        "workflow_path",
        "workflow_ref",
        "workflow_blob_oid",
        "workflow_blob_sha256",
        "event",
        "head_sha",
        "artifact_id",
        "artifact_name",
        "artifact_api_digest"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "repository_id": {
          "$ref": "#/$defs/positive_id"
        },
        "owner_id": {
          "$ref": "#/$defs/positive_id"
        },
        "workflow_id": {
          "$ref": "#/$defs/positive_id"
        },
        "run_id": {
          "$ref": "#/$defs/positive_id"
        },
        "run_attempt": {
          "$ref": "#/$defs/positive_id"
        },
        "head_repository_id": {
          "$ref": "#/$defs/positive_id"
        },
        "workflow_path": {
          "$ref": "#/$defs/relative_path"
        },
        "workflow_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[\\x20-\\x7E]+$(?![\\s\\S])"
        },
        "workflow_blob_oid": {
          "$ref": "#/$defs/git_oid"
        },
        "workflow_blob_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x20-\\x7E]+$(?![\\s\\S])"
        },
        "head_sha": {
          "$ref": "#/$defs/git_oid"
        },
        "artifact_id": {
          "$ref": "#/$defs/positive_id"
        },
        "artifact_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\x20-\\x7E]+$(?![\\s\\S])"
        },
        "artifact_api_digest": {
          "$ref": "#/$defs/api_digest"
        }
      }
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "repository_id",
        "owner_id",
        "workflow_id",
        "run_id",
        "run_attempt",
        "head_repository_id",
        "workflow_path",
        "workflow_ref",
        "workflow_blob_oid",
        "workflow_blob_sha256",
        "event",
        "head_sha",
        "environment_id",
        "environment_name",
        "permitted_reviewer_ids",
        "expected_producer",
        "expected_manifest_sha256"
      ],
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "repository_id": {
          "$ref": "#/$defs/positive_id"
        },
        "owner_id": {
          "$ref": "#/$defs/positive_id"
        },
        "workflow_id": {
          "$ref": "#/$defs/positive_id"
        },
        "run_id": {
          "$ref": "#/$defs/positive_id"
        },
        "run_attempt": {
          "$ref": "#/$defs/positive_id"
        },
        "head_repository_id": {
          "$ref": "#/$defs/positive_id"
        },
        "workflow_path": {
          "$ref": "#/$defs/relative_path"
        },
        "workflow_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[\\x20-\\x7E]+$(?![\\s\\S])"
        },
        "workflow_blob_oid": {
          "$ref": "#/$defs/git_oid"
        },
        "workflow_blob_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "event": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[\\x20-\\x7E]+$(?![\\s\\S])"
        },
        "head_sha": {
          "$ref": "#/$defs/git_oid"
        },
        "environment_id": {
          "$ref": "#/$defs/positive_id"
        },
        "environment_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\x20-\\x7E]+$(?![\\s\\S])"
        },
        "permitted_reviewer_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/positive_id"
          }
        },
        "expected_producer": {
          "$ref": "#/$defs/producer"
        },
        "expected_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version",
        "executable_sha256"
      ],
      "properties": {
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\x20-\\x7E]+$(?![\\s\\S])"
        },
        "executable_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "signer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "principal",
        "public_key",
        "fingerprint_sha256",
        "receipt_namespace",
        "tag_namespace",
        "valid_after",
        "valid_before"
      ],
      "properties": {
        "principal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^[\\x20-\\x7E]+$(?![\\s\\S])"
        },
        "public_key": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16384,
          "pattern": "^[A-Za-z0-9@._+-]+ [A-Za-z0-9+/]+={0,2}$(?![\\s\\S])"
        },
        "fingerprint_sha256": {
          "type": "string",
          "pattern": "^SHA256:[A-Za-z0-9+/]{43}$(?![\\s\\S])",
          "minLength": 50,
          "maxLength": 50
        },
        "receipt_namespace": {
          "type": "string",
          "const": "fieldkit-release-receipt-v1"
        },
        "tag_namespace": {
          "type": "string",
          "const": "git"
        },
        "valid_after": {
          "$ref": "#/$defs/utc_datetime"
        },
        "valid_before": {
          "$ref": "#/$defs/utc_datetime"
        }
      }
    },
    "revocation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "sha256",
        "generation",
        "effective_at",
        "refresh_required_by"
      ],
      "properties": {
        "format": {
          "enum": [
            "openssh-krl",
            "openssh-public-keys"
          ]
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "generation": {
          "$ref": "#/$defs/positive_id"
        },
        "effective_at": {
          "$ref": "#/$defs/utc_datetime"
        },
        "refresh_required_by": {
          "$ref": "#/$defs/utc_datetime"
        }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "python",
        "uv",
        "git",
        "ssh_keygen",
        "runtime_manifest_sha256",
        "uv_lock_sha256"
      ],
      "properties": {
        "python": {
          "$ref": "#/$defs/tool"
        },
        "uv": {
          "$ref": "#/$defs/tool"
        },
        "git": {
          "$ref": "#/$defs/tool"
        },
        "ssh_keygen": {
          "$ref": "#/$defs/tool"
        },
        "runtime_manifest_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "uv_lock_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
