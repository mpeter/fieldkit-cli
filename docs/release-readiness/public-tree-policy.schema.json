{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mpeter/fieldkit-cli/blob/main/docs/release-readiness/public-tree-policy.schema.json",
  "title": "fieldkit public tree policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "expected_repository", "planned_tag", "rules"],
  "properties": {
    "schema_version": {"const": 1},
    "expected_repository": {"type": "string", "pattern": "^[a-z0-9-]+/fieldkit-cli$"},
    "planned_tag": {"const": "v1.0.0"},
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "category", "patterns", "rationale"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "action": {"enum": ["include", "exclude"]},
          "category": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "patterns": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "rationale": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
