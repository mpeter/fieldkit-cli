{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mpeter/fieldkit-cli/blob/main/docs/release-readiness/cutover-record.schema.json",
  "title": "fieldkit public cutover record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate", "public"],
  "properties": {
    "schema_version": {"const": 1},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "source_sha", "source_tree", "export_policy_sha256", "exported_tree", "planned_tag", "artifacts"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "export_policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "exported_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "planned_tag": {"type": "string", "pattern": "^v[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "artifacts": {"$ref": "#/$defs/artifacts"}
      }
    },
    "public": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_commit", "initial_tree", "repository_id", "workflow_runs"],
      "properties": {
        "initial_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "initial_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "repository_id": {"type": "integer", "minimum": 1},
        "workflow_runs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "path", "event", "id", "attempt", "head_sha", "conclusion"],
            "properties": {
              "name": {"const": "Cutover verification"},
              "path": {"const": ".github/workflows/cutover.yml"},
              "event": {"const": "push"},
              "id": {"type": "integer", "minimum": 1},
              "attempt": {"type": "integer", "minimum": 1},
              "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
              "conclusion": {"const": "success"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifacts": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "kind", "sha256"],
        "properties": {
          "name": {"type": "string", "pattern": "^[^/\\\\\\u0000\\r\\n]+$"},
          "kind": {"enum": ["wheel", "sdist"]},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      },
      "allOf": [
        {"contains": {"properties": {"kind": {"const": "wheel"}}, "required": ["kind"]}},
        {"contains": {"properties": {"kind": {"const": "sdist"}}, "required": ["kind"]}}
      ]
    }
  }
}
