{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pursuit Frontmatter",
  "description": "JSON Schema for pursuit file YAML frontmatter.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "stage",
    "gate-status"
  ],
  "not": {
    "required": [
      "meddpicc",
      "legacy_meddpicc"
    ]
  },
  "properties": {
    "stage": {
      "type": "string",
      "enum": [
        "pre-pipeline",
        "prospect",
        "qualify",
        "discover",
        "validate",
        "propose",
        "negotiate",
        "closed-won",
        "closed-lost"
      ]
    },
    "gate-status": {
      "type": "string",
      "enum": [
        "pending",
        "pass",
        "fail",
        "override"
      ]
    },
    "last-transition": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "transition-history": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "date"
        ],
        "properties": {
          "date": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "gate-result": {
            "type": "string",
            "enum": [
              "pass",
              "fail",
              "override"
            ]
          },
          "override-reason": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "meddpicc": {
      "type": [
        "object",
        "null"
      ],
      "description": "Read-compatible former local score shape. Null is absent history; canonical writes omit it or migrate an object to legacy_meddpicc without interpreting its values.",
      "if": {
        "type": "object"
      },
      "then": {
        "not": {
          "anyOf": [
            {
              "required": [
                "schema_version"
              ]
            },
            {
              "required": [
                "status"
              ]
            }
          ]
        }
      },
      "additionalProperties": true
    },
    "legacy_meddpicc": {
      "type": [
        "object",
        "null"
      ],
      "required": [
        "schema_version",
        "status"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "status": {
          "const": "historical"
        }
      },
      "additionalProperties": true,
      "description": "Versioned historical local MEDDPICC evidence, or null for absent history. Element values and the original composite are retained verbatim and have no current qualification semantics."
    },
    "sf_opportunity_id": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sf_name": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sf_stage": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sf_close_date": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sf_arr": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "sf_owner": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sf_next_steps": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sf_last_pulled": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "sf_acv": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "sf_consulting_acv": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "sf_training_acv": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "sf_probability": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "number"
        },
        {
          "type": "null"
        }
      ]
    },
    "last-updated": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sf_deal_splits": {
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "offering": {
                "type": "string"
              },
              "pct": {
                "type": "number"
              }
            },
            "required": [
              "offering",
              "pct"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "gdoc_workbook": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": "",
      "description": "Google Doc ID for the Pursuit Workbook (single doc with tabs: Overview + per-meeting tabs)"
    },
    "sf_opportunity_number": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Salesforce Opportunity Number (e.g. '71721820') — join key for Varicent attainment reports in the format <number>-<year>."
    },
    "sf_contract_type": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Derived contract type for services: \"fixed_price\" | \"standard\" (historic regression). Consumers re-anchor ACV to net for fixed_price; absent is treated as standard."
    }
  }
}
